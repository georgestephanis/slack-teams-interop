# Server
PORT=3978
HOST=0.0.0.0
# Public HTTPS base URL of this service; used in generated Slack/Teams manifests
PUBLIC_URL=https://bridge.example.com
DATABASE_PATH=./data/bridge.sqlite
# Days to keep Slack<->Teams message ID pairs (needed for threading and reactions)
MESSAGE_RETENTION_DAYS=30

# Slack Configuration
# Obtain from api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
# true: Socket Mode (needs SLACK_APP_TOKEN, no inbound port). false: HTTP Events API at <PUBLIC_URL>/slack/events (needs SLACK_SIGNING_SECRET)
SLACK_USE_SOCKET_MODE=true

# Microsoft Teams / Azure Bot Configuration
# Obtain from portal.azure.com (Azure AI Bot Service)
TEAMS_APP_ID=your-azure-bot-app-id
TEAMS_APP_PASSWORD=your-azure-bot-app-secret
TEAMS_TENANT_ID=your-microsoft-tenant-id
# SingleTenant for bots registered after July 2025 (Azure no longer creates multi-tenant bots).
# MultiTenant only for older registrations. Must match the bot's "Type of App" in Azure.
TEAMS_APP_TYPE=SingleTenant
TEAMS_SERVICE_URL=https://smba.trafficmanager.net/amer/

# Media: show Slack images inline in Teams through signed proxy URLs (<PUBLIC_URL>/media/slack/...).
# Leave unset to relay Slack images as links. Anyone with a proxy link can view that one image;
# changing this secret revokes every link. Generate with: openssl rand -base64 48
# MEDIA_PROXY_SECRET=

# Security
# Password for the admin dashboard and REST API (HTTP Basic auth; any username). CHANGE THIS.
ADMIN_PASSWORD=admin
