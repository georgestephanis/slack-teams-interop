# Server
PORT=3978
HOST=0.0.0.0
DATABASE_PATH=./data/bridge.sqlite

# Slack Configuration
# Obtain from api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_USE_SOCKET_MODE=true

# Microsoft Teams / Azure Bot Configuration
# Obtain from portal.azure.com (Azure AI Bot Service)
TEAMS_APP_ID=your-azure-bot-app-id
TEAMS_APP_PASSWORD=your-azure-bot-app-secret
TEAMS_TENANT_ID=your-microsoft-tenant-id
TEAMS_SERVICE_URL=https://smba.trafficmanager.net/amer/

# Security
# Password for the admin dashboard and REST API (HTTP Basic auth; any username). CHANGE THIS.
ADMIN_PASSWORD=admin
